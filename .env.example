# YouTube Video Generator - Environment Variables
# Copie este arquivo para .env e configure suas chaves

# Pexels API - Stock footage gratuito
# https://pexels.com/api
PEXELS_API_KEY=sua_chave_aqui

# ElevenLabs API - Narração profissional
# https://elevenlabs.io
ELEVENLABS_API_KEY=sua_chave_aqui

# YouTube Data API (opcional)
# https://console.cloud.google.com
YOUTUBE_CLIENT_ID=seu_client_id
YOUTUBE_CLIENT_SECRET=seu_client_secret